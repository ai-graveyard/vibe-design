{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibe-design",
  "main": "cloudflare/site-worker.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "routes": [
    { "pattern": "v2ai.org/vibe-design*", "zone_name": "v2ai.org" }
  ],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/vibe-design"]
  }
}
